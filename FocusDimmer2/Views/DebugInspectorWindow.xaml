<components:FluentWindow x:Class="FocusDimmer.Views.DebugInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:FocusDimmer.Components"
        mc:Ignorable="d"
        Title="Focus Dimmer Inspector" SizeToContent="WidthAndHeight" MaxWidth="500"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Style="{StaticResource FluentWindowStyle}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Courrier New, Monospace"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Focus Dimmer Inspector" FontWeight="Bold" FontSize="14" Margin="0,0,0,2" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" FontFamily="Segoe UI, Segoe Fluent Icons"/>
            <TextBlock x:Name="StatusText" Text="Click to freeze" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,10" FontFamily="Segoe UI"/>
            
            <ListView x:Name="WindowList" Background="Transparent" BorderThickness="0" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="WindowList_SelectionChanged"
                      MinWidth="250" MaxHeight="600">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,5">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayHeader}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding DisplayDetails}" Foreground="#90FFFFFF" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </StackPanel>
    </Grid>
</components:FluentWindow>
