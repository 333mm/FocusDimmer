<Window x:Class="FocusDimmer.Views.InspectorActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Action" Height="Auto" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        SizeToContent="Height">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#CC101010" CornerRadius="12" BorderBrush="#30FFFFFF" BorderThickness="1" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel Margin="20">
            <TextBlock Text="{Binding ProcessName}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding WindowTitle}" Foreground="#90FFFFFF" FontSize="11" TextWrapping="Wrap" MaxHeight="40" Margin="0,0,0,20"/>

            <Button Content="{Binding Strings.BtnAddIgnore}" Click="Action_Click" Tag="Ignore" Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="{Binding Strings.BtnAddBright}" Click="Action_Click" Tag="Bright" Style="{StaticResource ActionButtonStyle}" Margin="0,10,0,0"/>
            <Button Content="{Binding Strings.BtnAddDark}" Click="Action_Click" Tag="Dark" Style="{StaticResource ActionButtonStyle}" Margin="0,10,0,0"/>
            <Button Content="{Binding Strings.BtnCancel}" Click="Action_Click" Tag="Cancel" Style="{StaticResource CancelButtonStyle}" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
