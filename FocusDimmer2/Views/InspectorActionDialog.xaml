<components:FluentWindow x:Class="FocusDimmer.Views.InspectorActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:FocusDimmer.Components"
        xmlns:local="clr-namespace:FocusDimmer.Views"
        Title="Select Action" Height="Auto" Width="350"
        ResizeMode="NoResize"
        Style="{StaticResource FluentWindowStyle}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        SizeToContent="Height">
    
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding WindowTitle}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" MaxHeight="40" Margin="0,0,0,20"/>

            <Button Content="{Binding Strings.BtnAddIgnore}" Click="Action_Click" Tag="Ignore" Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="{Binding Strings.BtnAddBright}" Click="Action_Click" Tag="Bright" Style="{StaticResource ActionButtonStyle}" Margin="0,10,0,0"/>
            <Button Content="{Binding Strings.BtnAddDark}" Click="Action_Click" Tag="Dark" Style="{StaticResource ActionButtonStyle}" Margin="0,10,0,0"/>
            <Button Content="{Binding Strings.BtnCancel}" Click="Action_Click" Tag="Cancel" Style="{StaticResource CancelButtonStyle}" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</components:FluentWindow>
