<Window x:Class="FocusDimmer.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Color"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        SizeToContent="WidthAndHeight"
        Background="#202020"
        Foreground="White"
        AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarBackground" Color="#252525"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="8" BorderThickness="1" BorderBrush="#404040">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBackground}" Height="32" VerticalAlignment="Top">
                <TextBlock Text="{Binding DataContext.Strings.TitleColorPicker, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="#A0A0A0"/>
                <Button Click="CloseButton_Click" HorizontalAlignment="Right" Width="40" Height="32" Background="Transparent" BorderThickness="0" Foreground="#A0A0A0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" x:Name="border">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Color Area (SV) -->
                <Grid x:Name="ColorArea" Width="256" Height="256" VerticalAlignment="Top" MouseLeftButtonDown="ColorArea_MouseDown" MouseLeftButtonUp="ColorArea_MouseUp" MouseMove="ColorArea_MouseMove" Background="Red">
                    <Grid.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Width="256" Height="256" CornerRadius="4" Background="White"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.OpacityMask>
                    
                    <Rectangle Width="256" Height="256">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="256" Height="256">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Thumb -->
                    <Canvas>
                        <Ellipse x:Name="ColorThumb" Width="10" Height="10" Stroke="White" StrokeThickness="2" Fill="Transparent" Margin="-5,-5,0,0" IsHitTestVisible="False"/>
                        <Ellipse x:Name="ColorThumbBlack" Width="12" Height="12" Stroke="Black" StrokeThickness="1" Fill="Transparent" Margin="-6,-6,0,0" IsHitTestVisible="False" Opacity="0.5"/>
                    </Canvas>
                </Grid>

                <!-- Controls -->
                <StackPanel Grid.Column="2">
                    <!-- Preview -->
                    <Border Height="60" CornerRadius="4" BorderThickness="1" BorderBrush="#404040" Margin="0,0,0,20">
                        <Border.Background>
                            <VisualBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                                <VisualBrush.Visual>
                                    <Canvas Background="#151515" Width="20" Height="20">
                                        <Rectangle Fill="#252525" Width="10" Height="10"/>
                                        <Rectangle Fill="#252525" Canvas.Left="10" Canvas.Top="10" Width="10" Height="10"/>
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                        <Grid>
                            <Border Background="{Binding CurrentColorBrush, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="4"/>
                        </Grid>
                    </Border>

                    <!-- Hue Slider -->
                    <Grid Height="20" Margin="0,0,0,20">
                         <Rectangle RadiusX="4" RadiusY="4">
                             <Rectangle.Fill>
                                 <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                     <GradientStop Color="#FF0000" Offset="0.0"/>
                                     <GradientStop Color="#FFFF00" Offset="0.167"/>
                                     <GradientStop Color="#00FF00" Offset="0.333"/>
                                     <GradientStop Color="#00FFFF" Offset="0.5"/>
                                     <GradientStop Color="#0000FF" Offset="0.667"/>
                                     <GradientStop Color="#FF00FF" Offset="0.833"/>
                                     <GradientStop Color="#FF0000" Offset="1.0"/>
                                 </LinearGradientBrush>
                             </Rectangle.Fill>
                         </Rectangle>
                         <Canvas x:Name="HueSlider" Background="Transparent" MouseLeftButtonDown="HueSlider_MouseDown" MouseLeftButtonUp="HueSlider_MouseUp" MouseMove="HueSlider_MouseMove">
                             <Rectangle x:Name="HueThumb" Width="4" Height="20" Fill="White" Stroke="Black" StrokeThickness="1" Margin="-2,0,0,0"/>
                         </Canvas>
                    </Grid>

                    <!-- Inputs -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hex" VerticalAlignment="Center" Foreground="#A0A0A0" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding HexString, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                 Background="#303030" Foreground="White" BorderThickness="0" Padding="8,6" VerticalContentAlignment="Center"
                                 LostFocus="HexInput_LostFocus" KeyDown="HexInput_KeyDown"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="R" Foreground="#A0A0A0" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding R, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" Background="#303030" Foreground="White" BorderThickness="0" Padding="5,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="G" Foreground="#A0A0A0" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding G, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" Background="#303030" Foreground="White" BorderThickness="0" Padding="5,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="B" Foreground="#A0A0A0" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding B, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" Background="#303030" Foreground="White" BorderThickness="0" Padding="5,4"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
                <Button Content="Cancel" Click="CloseButton_Click" Width="80" Height="32" Margin="0,0,10,0" Background="Transparent" Foreground="White" BorderBrush="#404040"/>
                <Button Content="OK" Click="OkButton_Click" Width="80" Height="32" Background="#60CDFF" Foreground="#101010" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
