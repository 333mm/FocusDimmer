<components:FluentWindow x:Class="FocusDimmer.Views.MigrationGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FocusDimmer.Views"
        xmlns:components="clr-namespace:FocusDimmer.Components"
        mc:Ignorable="d"
        Title="{Binding Strings.TitleMigrationGuide}" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource FluentWindowStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="📢" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24">
            <TextBlock Text="{Binding MigrationGuideText}" 
                        Foreground="{StaticResource TextSecondary}" 
                        FontSize="14" 
                        TextWrapping="Wrap" 
                        LineHeight="22"/>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Stretch">
            <Button Click="OpenStore_Click" 
                    Background="#FFB900" 
                    Foreground="Black"
                    BorderThickness="0" 
                    Padding="16,10"
                    HorizontalAlignment="Stretch"
                    Cursor="Hand"
                    Margin="0,0,0,12">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MigrationOpenStorePage}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Click="Close_Click" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextTertiary}"
                    BorderThickness="0" 
                    Padding="16,8"
                    HorizontalAlignment="Center"
                    Cursor="Hand">
                <TextBlock Text="{Binding Strings.BtnCancel, FallbackValue='Close'}" TextDecorations="Underline"/>
            </Button>
        </StackPanel>
    </Grid>
</components:FluentWindow>
