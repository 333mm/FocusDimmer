<Window x:Class="FocusDimmer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusDimmer"
        xmlns:converters="clr-namespace:FocusDimmer.Converters"
        Title="{Binding Strings.AppTitle}" Height="1000" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="#99101010"
        Foreground="White"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="5" 
                      CornerRadius="0" 
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:HexToColorConverter x:Key="HexToColorConverter"/>

        <!-- Colors & Brushes -->
        <Color x:Key="ColorAccent">#60CDFF</Color>
        <Color x:Key="ColorAccentHover">#78D9FF</Color>
        <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
        <Color x:Key="ColorTextSecondary">#D0D0D0</Color>
        <Color x:Key="ColorTextTertiary">#909090</Color>
        <Color x:Key="ColorControlBg">#25FFFFFF</Color>
        <Color x:Key="ColorControlBgHover">#35FFFFFF</Color>
        <Color x:Key="ColorCardBg">#15FFFFFF</Color>
        
        <SolidColorBrush x:Key="WindowBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="CardBackground" Color="{StaticResource ColorCardBg}"/>
        <SolidColorBrush x:Key="ControlBackground" Color="{StaticResource ColorControlBg}"/>
        <SolidColorBrush x:Key="ControlBackgroundHover" Color="{StaticResource ColorControlBgHover}"/>
        <SolidColorBrush x:Key="AccentColor" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
        <SolidColorBrush x:Key="AccentHover" Color="{StaticResource ColorAccentHover}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource ColorTextTertiary}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#15FFFFFF"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Styles -->
        <Style TargetType="{x:Type Button}" x:Key="CaptionButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="CloseButtonStyle" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B3271C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Win11ScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource Win11Thumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11Thumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumb" Background="#808080" CornerRadius="4" Margin="3,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Grid.Column="0" Margin="{TemplateBinding Padding}" Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Style="{StaticResource Win11ScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Meiryo UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="border" Width="20" Height="20" CornerRadius="4" Background="{StaticResource ControlBackground}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,10,0">
                                <Path x:Name="check" Data="M 4,10 L 8,14 L 16,6" Stroke="White" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Margin" Value="10,0,5,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Name="TrackBackground" Background="#40FFFFFF" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                            <Canvas VerticalAlignment="Center" Height="4">
                                <Border Name="PART_SelectionRange" Height="4" Background="{StaticResource AccentColor}" CornerRadius="2" Visibility="Hidden"/>
                            </Canvas>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="20" Height="20" Fill="{StaticResource AccentColor}" Stroke="{StaticResource TextPrimary}" StrokeThickness="2"/>
                                                    <Ellipse Width="20" Height="20" Fill="Transparent" Name="hoverOverlay"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="hoverOverlay" Property="Fill" Value="#20FFFFFF"/>
                                                        <Setter Property="RenderTransform">
                                                             <Setter.Value>
                                                                 <ScaleTransform ScaleX="1.1" ScaleY="1.1" CenterX="10" CenterY="10"/>
                                                             </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="hoverOverlay" Property="Fill" Value="#40FFFFFF"/>
                                                        <Setter Property="RenderTransform">
                                                             <Setter.Value>
                                                                 <ScaleTransform ScaleX="0.9" ScaleY="0.9" CenterX="10" CenterY="10"/>
                                                             </Setter.Value>
                                                        </Setter>
                                                    </Trigger>

                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" />
                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" 
                           Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlBackgroundHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlBackgroundHover}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="RoundedComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" 
                                          Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,23,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#202020" BorderThickness="1" BorderBrush="#303030" CornerRadius="4" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.4" ShadowDepth="4"/>
                                        </Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="12,8" 
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlBackground}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Title removed from top bar -->
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                 <Button Click="MinimizeButton_Click" Style="{StaticResource CaptionButtonStyle}">
                     <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                 </Button>
                 <Button Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}">
                     <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                 </Button>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="24,10,24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/icon.ico" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Strings.AppTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    
                    <!-- NEW: FREE Badge -->
                    <Border Visibility="{Binding FreeBannerVisibility}" Background="#2260CDFF" BorderBrush="#8860CDFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FREE" Foreground="#FF60CDFF" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <!-- NEW: PRO Badge -->
                    <!-- NEW: PRO Badge -->
                    <!-- NEW: PRO Badge -->
                    <Border Visibility="{Binding ProBadgeVisibility}" Background="#22FFB900" BorderBrush="#88FFB900" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO" Foreground="#FFFFB900" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="{Binding AppVersion}" FontSize="14" Foreground="{StaticResource TextTertiary}" Margin="12,0,0,0" VerticalAlignment="Bottom" Opacity="0.7" Padding="0,0,0,4"/>
                    
                    <!-- NEW: Megaphone Icon (Moved from Badge) -->
                    <Button Visibility="{Binding ProBadgeWithIconVisibility}" Click="MigrationInfo_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Migration Info">
                        <TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </Button>
                </StackPanel> 
                <ComboBox Grid.Column="1" Width="140" Height="34" SelectedIndex="{Binding SelectedLanguageIndex}" 
                            Style="{StaticResource RoundedComboBox}" HorizontalAlignment="Right">
                    <ComboBoxItem Content="English"/>
                    <ComboBoxItem Content="日本語"/>
                    <ComboBoxItem Content="简体中文"/>
                    <ComboBoxItem Content="Deutsch"/>
                    <ComboBoxItem Content="Español"/>
                    <ComboBoxItem Content="Português"/>
                    <ComboBoxItem Content="Français"/>
                </ComboBox>
            </Grid>

            <!-- Compact Banners below Title -->
            <!-- Compact Banners below Title -->
            <Button Visibility="{Binding FreeBannerVisibility}" Click="OpenStore_Click" Margin="0,10,0,0" HorizontalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0">
                <Border Background="#2260CDFF" BorderBrush="#8860CDFF" BorderThickness="1" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Strings.BannerText}" Foreground="#FF60CDFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Button>

            <Grid Visibility="{Binding LegacyBannerVisibility}" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button Click="MigrationInfo_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border Background="#22FFB900" BorderBrush="#88FFB900" BorderThickness="1" CornerRadius="6" Padding="12,6,32,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📢" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.MigrationBannerLink}" Foreground="#FFFFB900" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>
                <!-- Close Button Inside Banner (No negative margins) -->
                <Button Click="CloseBanner_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Foreground="#FFFFB900" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

        </StackPanel>

        <TabControl x:Name="MonitorTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                    Padding="0,0,0,0" ItemsSource="{Binding MonitorProfiles}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="24,0,24,0">

            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" Margin="0,0,0,10"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MonitorName}" TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding MonitorName}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,10">
                            <StackPanel>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.HeaderOverlay, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Click="PickColor_Click" Background="Transparent" Padding="0"
                                                    Style="{StaticResource {x:Type Button}}">
                                                <Border CornerRadius="12" Background="{StaticResource ControlBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelColor, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11"/>
                                                        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="#555">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding OverlayColorHex, Converter={StaticResource HexToColorConverter}}"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.LabelOpacity, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox Style="{StaticResource NumTextBox}" Text="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="95" Value="{Binding Opacity}" TickFrequency="5" Margin="0,0,0,24"/>

                                        <StackPanel IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE745;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DataContext.Strings.LabelMargin, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBox Style="{StaticResource NumTextBox}" Text="{Binding Margin, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="px" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Slider Minimum="-50" Maximum="100" Value="{Binding Margin}" TickFrequency="1" Margin="0,0,0,24"/>
                                        </StackPanel>

                                        <!-- Dim Desktop Only (Moved UP) -->
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding DimDesktopOnly}" Content="{Binding DataContext.Strings.CheckDimDesktopOnly, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                       Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                       ToolTip="{Binding DataContext.Strings.TooltipDimDesktopOnly, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>

                                        <StackPanel Margin="20,0,0,0">
                                            <CheckBox IsChecked="{Binding ExcludeTaskbar}" Content="{Binding DataContext.Strings.CheckTaskbar, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                      IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}"/>
                                            <CheckBox IsChecked="{Binding ExcludeTopmost}" Content="{Binding DataContext.Strings.CheckTopmost, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}"/>
                                            <CheckBox IsChecked="{Binding UseTightFrame}" Content="{Binding DataContext.Strings.CheckTightFrame, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}"/>
                                        </StackPanel>

                                        <Separator Background="#30FFFFFF" Margin="0,12,0,12"/>

                                        <!-- Dim Entirely / Idle (Moved DOWN & Pro Locked) -->
                                        <Border IsEnabled="{Binding DataContext.IsPro, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <!-- Pro Header for this section -->
                                                <Grid Margin="0,0,0,10" Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <TextBlock Text="🔒 PRO" HorizontalAlignment="Right" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="10"/>
                                                </Grid>
                                                
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding DimEntirelyWhenInactive}" Content="{Binding DataContext.Strings.CheckDimEntirely, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Strings.TooltipDimEntirely, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding DimWhenIdle}" Content="{Binding DataContext.Strings.CheckDimWhenIdle, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Strings.TooltipDimWhenIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,5" Visibility="{Binding DimWhenIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Margin="28,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelIdleTime, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <!-- Grid inside StackPanel with Margin shifts width. But Auto col leans right. -->
                                                        <!-- To fix alignment with above items, we need to ensure the right edge matches. -->
                                                        <!-- Since Margin is on the Grid, it's indenting the whole grid. -->
                                                        <!-- The TextBoxes above end at Right=Width. This ends at Right=Width-28?? No, Margin reduces size but doesn't shift right edge to left? -->
                                                        <!-- Wait, Margin Left pushes content Right. So Right Edge is at ParentRight. -->
                                                        <!-- But if Parents width is restricted... -->
                                                        <!-- Actually the visual issue is likely simply due to different container widths or margins. -->
                                                        <!-- Let's match the margins of other items. -->
                                                        <!-- The other textboxes use 'NumTextBox' style which has margin '10,0,5,0'. -->
                                                        <!-- I will remove the Grid Margin '28' and use Padding on a container or margin on the left textblock instead to indent ONLY the label -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource NumTextBox}" Text="{Binding IdleTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="min" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="1" Maximum="120" Value="{Binding IdleTimeout}" TickFrequency="1" Margin="28,5,0,10"/>

                                                    <!-- New Idle Opacity Slider -->
                                                    <Grid Margin="28,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelOpacity, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>

                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource NumTextBox}" Text="{Binding IdleDimOpacity, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="95" Value="{Binding IdleDimOpacity}" TickFrequency="5" Margin="28,5,0,5"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding DataContext.IsPro, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.HeaderAnimation, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>
                                            <TextBlock Text="🔒 PRO" HorizontalAlignment="Right" Foreground="{StaticResource AccentColor}" FontWeight="Bold" 
                                                       Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding DataContext.Strings.LabelDarken, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelWait, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                                   Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                                   ToolTip="{Binding DataContext.Strings.TooltipWait, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DelayDarken, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="60" Value="{Binding DelayDarken}" TickFrequency="1" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelDuration, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DurationDarken, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="5" Value="{Binding DurationDarken}" TickFrequency="0.1"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="#30FFFFFF" Margin="0,15,0,15"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding DataContext.Strings.LabelBrighten, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelDuration, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DurationBrighten, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="5" Value="{Binding DurationBrighten}" TickFrequency="0.1"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding DataContext.IsPro, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.HeaderExclusionLists, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Debug Inspector Button -->
                                                <ToggleButton x:Name="DebugInspectorButton" Click="DebugInspector_Click" Cursor="Hand" 
                                                              ToolTip="{Binding DataContext.Strings.TooltipDebugInspector, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              Margin="0,0,10,0">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                            <Setter Property="Padding" Value="8,3"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding DataContext.Strings.BtnDebug, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="#44FFB900"/>
                                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFB900"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <TextBlock Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" VerticalAlignment="Center"
                                                           Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding DataContext.Strings.LabelAppList, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding IgnoreList, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                            <Button Grid.Column="1" Content="..." Click="BrowseApp_Click" Margin="8,0,0,0" Width="36" Height="32"/>
                                        </Grid>

                                        <TextBlock Text="{Binding DataContext.Strings.LabelAlwaysBright, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AlwaysBrightList, UpdateSourceTrigger=PropertyChanged}" Height="32" BorderBrush="#228822" BorderThickness="0,0,0,2"/>
                                            <Button Grid.Column="1" Content="..." Click="BrowseBright_Click" Margin="8,0,0,0" Width="36" Height="32"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding DataContext.Strings.LabelAlwaysDark, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                       Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                       ToolTip="{Binding DataContext.Strings.TooltipAlwaysDark, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AlwaysDarkList, UpdateSourceTrigger=PropertyChanged}" Height="32" BorderBrush="#882222" BorderThickness="0,0,0,2"/>
                                            <Button Grid.Column="1" Content="..." Click="BrowseDark_Click" Margin="8,0,0,0" Width="36" Height="32"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="20" Margin="24,10,24,24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Strings.LabelToggle}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                        <TextBox x:Name="HotkeyToggleBox" IsReadOnly="True" Width="110" Height="26" Background="#20FFFFFF"
                                 Text="Ctrl + Alt + Home" FontWeight="Bold" TextAlignment="Center" Tag="Toggle"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" Padding="2" FontSize="10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <TextBlock Text="{Binding Strings.LabelDarker}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                        <TextBox x:Name="HotkeyDarkerBox" IsReadOnly="True" Width="100" Height="26" Background="#20FFFFFF"
                                 Text="Ctrl + Alt + PgUp" TextAlignment="Center" Tag="Darker" FontSize="10"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="{Binding Strings.LabelLighter}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                        <TextBox x:Name="HotkeyLighterBox" IsReadOnly="True" Width="100" Height="26" Background="#20FFFFFF"
                                 Text="Ctrl + Alt + PgDn" TextAlignment="Center" Tag="Lighter" FontSize="10"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"/>
                    </StackPanel>
                </WrapPanel>

                <Separator Background="#30FFFFFF" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Strings.HeaderStartup}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="{Binding Strings.CheckAutoStart}" Checked="AutoStart_Checked" Unchecked="AutoStart_Unchecked" Margin="0,0,20,0"/>
                        <CheckBox x:Name="AdminRunCheck" Content="{Binding Strings.CheckAdmin}" IsEnabled="{Binding ElementName=AutoStartCheck, Path=IsChecked}" Checked="AdminRun_Changed" Unchecked="AdminRun_Changed" Margin="0,0,20,0"/>
                    </WrapPanel>

                    <Button Grid.Column="1" Click="MinimizeButton_Click" 
                            MinWidth="120" Padding="15,0" Height="36" FontSize="12" FontWeight="SemiBold"
                            Background="{StaticResource AccentColor}" 
                            Foreground="#202020"
                            VerticalAlignment="Center">
                         <StackPanel Orientation="Horizontal">
                             <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                             <TextBlock Text="{Binding Strings.BtnClose}" VerticalAlignment="Center"/>
                         </StackPanel>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>