<components:FluentWindow x:Class="FocusDimmer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusDimmer"
        xmlns:components="clr-namespace:FocusDimmer.Components"
        xmlns:converters="clr-namespace:FocusDimmer.Converters"
        Title="{Binding Strings.AppTitle}" Height="720" Width="1020"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource FluentWindowStyle}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240"/>
            <!-- Right Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- LEFT SIDEBAR (NAVIGATION)                                 -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">

            <Grid Margin="8,14,8,14">
                <Grid.RowDefinitions>
                    <!-- App Title / Brand -->
                    <RowDefinition Height="Auto"/>
                    <!-- Promo Banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nav Items -->
                    <RowDefinition Height="*"/>
                    <!-- Footer / Minimize Button -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Area -->
                <Grid Grid.Row="0" Margin="8,2,8,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/icon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding Strings.AppTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        
                        <!-- FREE Badge -->
                        <Border Visibility="{Binding FreeBannerVisibility}" Background="#1560CDFF" BorderBrush="#3560CDFF" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FREE" Foreground="{StaticResource AccentColor}" FontSize="8.5" FontWeight="Bold"/>
                        </Border>

                        <!-- PRO Badge -->
                        <Border Visibility="{Binding ProBadgeVisibility}" Background="#25FFB900" BorderBrush="#60FFB900" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO" Foreground="#FFFFB900" FontSize="8.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>


                <!-- Legacy Migration Banner (Only for detected legacy users) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding LegacyBannerVisibility}">
                    <Grid>

                        <Button Click="MigrationInfo_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <Border Background="#15FFB900" BorderBrush="#35FFB900" BorderThickness="1" CornerRadius="6" Padding="10,6,24,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📢" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Strings.MigrationBannerLink}" Foreground="#FFFFB900" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Click="CloseBanner_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Foreground="#FFFFB900" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>


                <!-- Navigation List -->
                <StackPanel Grid.Row="2">
                    <!-- Nav: Monitors -->
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}" Tag="Monitors" IsChecked="True" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.NavMonitors, FallbackValue='Monitors'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nav: Exclusions -->
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}" Tag="Exclusions" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.NavExclusions, FallbackValue='Exclusions'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nav: Hotkeys -->
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}" Tag="Hotkeys" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.NavHotkeys, FallbackValue='Hotkeys'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nav: Presets (PRO) -->
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}" Tag="Presets" Checked="NavButton_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Strings.NavPresets, FallbackValue='Presets'}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Visibility="{Binding FreeBannerVisibility}" VerticalAlignment="Center"
                                    Background="#1560CDFF" BorderBrush="#3560CDFF" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                <TextBlock Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="8"/>
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- Nav: General -->
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}" Tag="General" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.NavGeneral, FallbackValue='General'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Footer / GitHub Button -->
                <StackPanel Grid.Row="3" Margin="4,0,4,0">
                    <Button Click="GitHub_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,8" ToolTip="{Binding Strings.TooltipGitHub, FallbackValue='GitHub'}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBackground}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" 
                                  Fill="{StaticResource TextSecondary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.BtnGitHub, FallbackValue='GitHub'}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


        <!-- ========================================================= -->
        <!-- RIGHT MAIN CONTENT AREA                                    -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="32,20,32,20">

            <!-- ===================================================== -->
            <!-- 1. PAGE: MONITORS                                     -->
            <!-- ===================================================== -->
            <Grid x:Name="PageMonitors" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header with Link Displays Toggle -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Strings.NavMonitors, FallbackValue='Monitors'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding Strings.HeaderOverlay}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Link / Unlink All Displays Toggle Button -->
                    <ToggleButton IsChecked="{Binding AreMonitorsLinked, Mode=TwoWay}" Click="LinkMonitors_Click"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                  ToolTip="{Binding Strings.TooltipLinkMonitors}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="icon" Text="&#xE7AC;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txt" Text="{Binding DataContext.Strings.LabelLinkMonitors, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3060CDFF"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                                    <Setter TargetName="icon" Property="Text" Value="&#xE71B;"/>
                                                    <Setter TargetName="icon" Property="Foreground" Value="{StaticResource AccentColor}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Grid>

                <!-- Monitor Tabs and Content -->
                <TabControl x:Name="MonitorTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                            Padding="0" ItemsSource="{Binding MonitorProfiles}">
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal" Margin="0,0,0,14"/>
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>

                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MonitorName}" TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding MonitorName}" VerticalAlignment="Center"/>
                                <!-- Locked Indicator for Sub-Monitors in Free version -->
                                <Border Margin="6,0,0,0" Padding="4,1" Background="#1560CDFF" BorderBrush="#3560CDFF" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPrimary}" Value="False"/>
                                                        <Condition Binding="{Binding DataContext.IsFreeVersion, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="🔒 PRO" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                                <StackPanel>
                                    <!-- Multi-Monitor Lock Card (Free Version on Sub-Monitors) -->
                                    <Border Margin="0,0,0,16" Background="#1260CDFF" BorderBrush="#3060CDFF" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPrimary}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.IsFreeVersion, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="🔒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DataContext.Strings.HeaderMultiMonitorPro, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                               Foreground="{StaticResource AccentColor}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DataContext.Strings.DescMultiMonitorPro, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="OpenStore_Click" Margin="16,0,0,0" Padding="14,6" Height="32" 
                                                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Cursor="Hand">
                                                <TextBlock Text="{Binding DataContext.Strings.BtnUpgradePro, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Main Settings Area (Disabled on Sub-monitors for Free version) -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPrimary}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.IsFreeVersion, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                    <!-- Card 1: Appearance & Dimming Color -->
                                    <Border Style="{StaticResource CardStyle}">

                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding DataContext.Strings.HeaderOverlay, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                </StackPanel>

                                                <!-- Color Picker Button -->
                                                <Button Grid.Column="1" Click="PickColor_Click" Background="Transparent" Padding="0"
                                                        Style="{StaticResource {x:Type Button}}">
                                                    <Border CornerRadius="6" Background="{StaticResource ControlBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelColor, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"/>
                                                            <Border Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#555" VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding OverlayColorHex, Converter={StaticResource HexToColorConverter}}"/>
                                                                </Border.Background>
                                                            </Border>
                                                            <!-- PRO Pill Badge for Free Version -->
                                                            <Border Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Background="#1560CDFF" BorderBrush="#3560CDFF" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="8"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Button>

                                            </Grid>

                                            <!-- Opacity Slider -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DataContext.Strings.LabelOpacity, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBox Style="{StaticResource NumTextBox}" Text="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="20" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="95" Value="{Binding Opacity}" TickFrequency="5" Margin="0,0,0,20"/>

                                            <!-- Margin Slider -->
                                            <StackPanel IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE745;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelMargin, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding Margin, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="px" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="20" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="-50" Maximum="100" Value="{Binding Margin}" TickFrequency="1" Margin="0,0,0,10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Targets & Scope -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <TextBlock Text="&#xE737;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.HeaderBehavior, FallbackValue='Targets &amp; Scope', RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>

                                            <!-- Dim Desktop Only Row -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataContext.Strings.CheckDimDesktopOnly, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0" 
                                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Strings.TooltipDimDesktopOnly, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DimDesktopOnly}"/>
                                            </Grid>

                                            <!-- Sub-options when not DimDesktopOnly -->
                                            <StackPanel Margin="0,6,0,0" IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <CheckBox IsChecked="{Binding ExcludeTaskbar}" Content="{Binding DataContext.Strings.CheckTaskbar, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,3"/>
                                                <CheckBox IsChecked="{Binding ExcludeTopmost}" Content="{Binding DataContext.Strings.CheckTopmost, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,3"/>
                                                <CheckBox IsChecked="{Binding UseTightFrame}" Content="{Binding DataContext.Strings.CheckTightFrame, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,3"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Advanced Dimming & Idle (PRO) -->
                                    <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding DataContext.IsPro, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding DataContext.Strings.HeaderAdvancedBehavior, FallbackValue='Advanced Behavior', RelativeSource={RelativeSource AncestorType=Window}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                </StackPanel>
                                                <Border Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Background="#1560CDFF" BorderBrush="#3560CDFF" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="9"/>
                                                </Border>
                                            </Grid>
                                            
                                            <!-- Setting 1: Dim Entirely When Inactive -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataContext.Strings.CheckDimEntirely, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0" 
                                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Strings.TooltipDimEntirely, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DimEntirelyWhenInactive}"/>
                                            </Grid>

                                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                                            
                                            <!-- Setting 2: Dim When Idle -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataContext.Strings.CheckDimWhenIdle, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0" 
                                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Strings.TooltipDimWhenIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DimWhenIdle}"/>
                                            </Grid>

                                            <!-- Idle Parameters (Expanded) -->
                                            <StackPanel Margin="0,10,0,0" Visibility="{Binding DimWhenIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <!-- Idle Timeout -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelIdleTime, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding IdleTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="min" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="1" Maximum="120" Value="{Binding IdleTimeout}" TickFrequency="1" Margin="0,0,0,12"/>

                                                <!-- Idle Opacity -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelOpacity, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding IdleDimOpacity, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="20" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="95" Value="{Binding IdleDimOpacity}" TickFrequency="5" Margin="0,0,0,6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Animation (PRO) -->
                                    <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding DataContext.IsPro, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                     <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                     <TextBlock Text="{Binding DataContext.Strings.HeaderAnimation, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                 </StackPanel>
                                                 <Border Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         Background="#1560CDFF" BorderBrush="#3560CDFF" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                                     <TextBlock Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="9"/>
                                                 </Border>
                                             </Grid>

                                            <!-- Fade In Settings -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DataContext.Strings.LabelDarken, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <!-- Wait -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelWait, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="4,0,0,0" 
                                                                       Foreground="{StaticResource TextTertiary}" Cursor="Help"
                                                                       ToolTip="{Binding DataContext.Strings.TooltipWait, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DelayDarken, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="16" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="60" Value="{Binding DelayDarken}" TickFrequency="1" Margin="0,0,0,10"/>

                                                    <!-- Duration -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelDuration, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DurationDarken, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="16" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="5" Value="{Binding DurationDarken}" TickFrequency="0.1"/>
                                                </StackPanel>
                                            </Grid>

                                            <Separator Background="#20FFFFFF" Margin="0,10,0,14"/>

                                            <!-- Fade Out Settings -->
                                            <Grid IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DataContext.Strings.LabelBrighten, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelDuration, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DurationBrighten, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="16" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="5" Value="{Binding DurationBrighten}" TickFrequency="0.1"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                     </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>


            <!-- ===================================================== -->
            <!-- 2. PAGE: APP EXCLUSIONS                               -->
            <!-- ===================================================== -->
            <Grid x:Name="PageExclusions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Strings.NavExclusions, FallbackValue='App Exclusions'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding Strings.SubHeaderGlobalSettings}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Debug Inspector Button -->
                    <ToggleButton x:Name="DebugInspectorButton" Click="DebugInspector_Click" Cursor="Hand" 
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  ToolTip="{Binding Strings.TooltipDebugInspector}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Strings.BtnDebug}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#35FFB900"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FFB900"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                    <StackPanel>
                        <!-- Card 1: Always Bright List -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Strings.LabelAlwaysBright}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AlwaysBrightList, UpdateSourceTrigger=PropertyChanged}" Height="34" BorderBrush="#358822" BorderThickness="0,0,0,2"/>
                                    <Button Grid.Column="1" Content="..." Click="BrowseBright_Click" Margin="8,0,0,0" Width="40" Height="34" ToolTip="{Binding Strings.BtnBrowse}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Always Dark List -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Strings.LabelAlwaysDark}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0" 
                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                               ToolTip="{Binding Strings.TooltipAlwaysDark}"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AlwaysDarkList, UpdateSourceTrigger=PropertyChanged}" Height="34" BorderBrush="#35882222" BorderThickness="0,0,0,2"/>
                                    <Button Grid.Column="1" Content="..." Click="BrowseDark_Click" Margin="8,0,0,0" Width="40" Height="34" ToolTip="{Binding Strings.BtnBrowse}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Non-dimming active app list -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Strings.LabelAppList}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding IgnoreList, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    <Button Grid.Column="1" Content="..." Click="BrowseApp_Click" Margin="8,0,0,0" Width="40" Height="34" ToolTip="{Binding Strings.BtnBrowse}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>


            <!-- ===================================================== -->
            <!-- 3. PAGE: SHORTCUTS                                    -->
            <!-- ===================================================== -->
            <Grid x:Name="PageHotkeys" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{Binding Strings.NavHotkeys, FallbackValue='Shortcuts'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding Strings.SubHeaderHotkeys, FallbackValue='Configure keyboard shortcuts to quickly control dimming.'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Hotkey 1: Toggle -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Strings.LabelToggle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <TextBox x:Name="HotkeyToggleBox" Grid.Column="1" IsReadOnly="True" Width="150" Height="32" Background="#20FFFFFF"
                                             Text="Ctrl + Alt + Home" FontWeight="Bold" TextAlignment="Center" Tag="Toggle"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"/>
                                </Grid>

                                <Separator Background="#20FFFFFF" Margin="0,0,0,16"/>

                                <!-- Hotkey 2: Darker -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Strings.LabelDarker}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <TextBox x:Name="HotkeyDarkerBox" Grid.Column="1" IsReadOnly="True" Width="150" Height="32" Background="#20FFFFFF"
                                             Text="Ctrl + Alt + PgUp" TextAlignment="Center" Tag="Darker"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"/>
                                </Grid>

                                <Separator Background="#20FFFFFF" Margin="0,0,0,16"/>

                                <!-- Hotkey 3: Lighter -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Strings.LabelLighter}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <TextBox x:Name="HotkeyLighterBox" Grid.Column="1" IsReadOnly="True" Width="150" Height="32" Background="#20FFFFFF"
                                             Text="Ctrl + Alt + PgDn" TextAlignment="Center" Tag="Lighter"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>


            <!-- ===================================================== -->
            <!-- 4. PAGE: PRESETS (PRO)                                -->
            <!-- ===================================================== -->
            <Grid x:Name="PagePresets" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Strings.NavPresets, FallbackValue='Presets'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding Strings.SubHeaderGlobalSettings}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Visibility="{Binding FreeBannerVisibility}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#1560CDFF" BorderBrush="#3560CDFF" BorderThickness="1" CornerRadius="3" Padding="5,1">
                        <TextBlock Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="9"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                    <StackPanel>
                        <!-- Pro Upgrade Banner (Free Version only) -->
                        <Border Visibility="{Binding FreeBannerVisibility}" Margin="0,0,0,16" Background="#1260CDFF" BorderBrush="#3060CDFF" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Strings.NavPresets, FallbackValue='Presets'}" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Strings.BannerText}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="OpenStore_Click" Margin="16,0,0,0" Padding="14,6" Height="32" 
                                        Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Cursor="Hand">
                                    <TextBlock Text="{Binding Strings.BtnUpgradePro}" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Presets Content (Disabled for Free version) -->
                        <StackPanel IsEnabled="{Binding IsPro}">
                        <!-- Preset Selector & Toolbar -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Strings.HeaderPreset, FallbackValue='Global Presets'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Click="AddGlobalPreset_Click" Margin="0,0,6,0" Padding="12,6" Height="32" Background="{StaticResource ControlBackground}" Cursor="Hand" ToolTip="{Binding Strings.TooltipAddPreset}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Strings.TooltipAddPreset, FallbackValue='New'}" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="EditGlobalPresetName_Click" Margin="0,0,6,0" Width="34" Height="32" Background="{StaticResource ControlBackground}" Cursor="Hand" ToolTip="{Binding Strings.TooltipEditPreset}">
                                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                        </Button>
                                        <Button Click="DeleteGlobalPreset_Click" Width="34" Height="32" Background="{StaticResource ControlBackground}" Cursor="Hand" ToolTip="{Binding Strings.TooltipDeletePreset}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ComboBox x:Name="PresetComboBox" Style="{StaticResource RoundedComboBox}" 
                                          ItemsSource="{Binding GlobalPresets}" SelectedValue="{Binding SelectedGlobalPresetId}" 
                                          SelectedValuePath="Id" DisplayMemberPath="Name" SelectionChanged="GlobalPreset_SelectionChanged" Height="34"/>
                            </StackPanel>
                        </Border>

                        <!-- Process Rules for Active Preset -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings.LabelAssociatedProcesses}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Strings.LabelProcessSwitch, FallbackValue='Automatically activates this preset when matching apps run.'}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ManageProcessRules_Click" Height="32" Padding="12,0" Background="{StaticResource ControlBackground}" Cursor="Hand" ToolTip="{Binding Strings.BtnAddProcessRule}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Strings.BtnAddProcessRule}" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding SelectedGlobalPreset.ProcessRules}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#20FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <Button Command="{Binding DataContext.RemoveProcessRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" Padding="0" Width="16" Height="16" Cursor="Hand">
                                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{StaticResource TextTertiary}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>



            <!-- ===================================================== -->
            <!-- 5. PAGE: GENERAL                                      -->
            <!-- ===================================================== -->
            <Grid x:Name="PageGeneral" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{Binding Strings.NavGeneral, FallbackValue='General'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding Strings.SubHeaderGeneral, FallbackValue='App startup, behavior and language settings.'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                    <StackPanel>
                        <!-- Card 1: Startup & Behavior -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Strings.HeaderStartup}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

                                <!-- Setting 1: Auto Start -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings.CheckAutoStart}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="AutoStartCheck" Style="{StaticResource ToggleSwitchStyle}" Checked="AutoStart_Checked" Unchecked="AutoStart_Unchecked"/>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                <!-- Setting 2: Admin Privileges -->
                                <Grid Margin="0,0,0,12" IsEnabled="{Binding ElementName=AutoStartCheck, Path=IsChecked}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings.CheckAdmin}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="AdminRunCheck" Style="{StaticResource ToggleSwitchStyle}" Checked="AdminRun_Changed" Unchecked="AdminRun_Changed"/>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                <!-- Setting 3: Close to Tray -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings.CheckCloseToTray}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Language -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Strings.HeaderLanguage, FallbackValue='Language'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Strings.SubHeaderLanguage, FallbackValue='Choose display language'}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Height="32" SelectedIndex="{Binding SelectedLanguageIndex}" 
                                          Style="{StaticResource RoundedComboBox}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="日本語"/>
                                    <ComboBoxItem Content="简体中文"/>
                                    <ComboBoxItem Content="Deutsch"/>
                                    <ComboBoxItem Content="Español"/>
                                    <ComboBoxItem Content="Português"/>
                                    <ComboBoxItem Content="Français"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Card 3: About -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Strings.AppTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding AppVersion, StringFormat='Version: {0}'}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="GitHub_Click" Margin="0,0,8,0"
                                            Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="10,6" Cursor="Hand" ToolTip="{Binding Strings.TooltipGitHub, FallbackValue='GitHub'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" 
                                                  Fill="{StaticResource TextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Strings.BtnGitHub, FallbackValue='GitHub'}" Foreground="{StaticResource TextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Visibility="{Binding ProBadgeWithIconVisibility}" Click="MigrationInfo_Click" 
                                            Background="Transparent" BorderThickness="1" BorderBrush="#50FFB900" Padding="12,6" Cursor="Hand" ToolTip="{Binding Strings.BtnMigrationInfo}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" Foreground="#FFFFB900" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Strings.BtnMigrationInfo, FallbackValue='Migration Info'}" Foreground="#FFFFB900" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>
    </Grid>
</components:FluentWindow>
