<components:FluentWindow x:Class="FocusDimmer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusDimmer"
        xmlns:components="clr-namespace:FocusDimmer.Components"
        xmlns:converters="clr-namespace:FocusDimmer.Converters"
        Title="{Binding Strings.AppTitle}" Height="680" Width="980"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource FluentWindowStyle}">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,12,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/icon.ico" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Strings.AppTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    
                    <!-- FREE Badge -->
                    <Border Visibility="{Binding FreeBannerVisibility}" Background="#2060CDFF" BorderBrush="#6060CDFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FREE" Foreground="#FF60CDFF" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <!-- PRO Badge -->
                    <Border Visibility="{Binding ProBadgeVisibility}" Background="#25FFB900" BorderBrush="#60FFB900" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO" Foreground="#FFFFB900" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                    
                    <!-- Megaphone Icon -->
                    <Button Visibility="{Binding ProBadgeWithIconVisibility}" Click="MigrationInfo_Click" Background="Transparent" BorderThickness="0" Padding="4" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Migration Info">
                        <TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" Foreground="#FFFFB900" FontSize="13"/>
                    </Button>
                </StackPanel> 
                <ComboBox Grid.Column="1" Width="130" Height="32" SelectedIndex="{Binding SelectedLanguageIndex}" 
                            Style="{StaticResource RoundedComboBox}" HorizontalAlignment="Right">
                    <ComboBoxItem Content="English"/>
                    <ComboBoxItem Content="日本語"/>
                    <ComboBoxItem Content="简体中文"/>
                    <ComboBoxItem Content="Deutsch"/>
                    <ComboBoxItem Content="Español"/>
                    <ComboBoxItem Content="Português"/>
                    <ComboBoxItem Content="Français"/>
                </ComboBox>
            </Grid>

            <!-- Compact Banners below Title -->
            <Button Visibility="{Binding FreeBannerVisibility}" Click="OpenStore_Click" Margin="0,8,0,0" HorizontalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0">
                <Border Background="#2060CDFF" BorderBrush="#5060CDFF" BorderThickness="1" CornerRadius="6" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Strings.BannerText}" Foreground="#FF60CDFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Button>

            <Grid Visibility="{Binding LegacyBannerVisibility}" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Button Click="MigrationInfo_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border Background="#20FFB900" BorderBrush="#50FFB900" BorderThickness="1" CornerRadius="6" Padding="12,5,30,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📢" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.MigrationBannerLink}" Foreground="#FFFFB900" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>
                <!-- Close Button Inside Banner -->
                <Button Click="CloseBanner_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Foreground="#FFFFB900" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

        </StackPanel>


        <!-- Main Content (Row 1) -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left Monitor Tabs (Column 0) -->
            <TabControl x:Name="MonitorTabs" Grid.Column="0" Background="Transparent" BorderThickness="0" 
                        Padding="0" ItemsSource="{Binding MonitorProfiles}" Margin="0,0,14,0">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal" Margin="0,0,0,10"/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitorName}" TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding MonitorName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                <StackPanel>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.HeaderOverlay, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Click="PickColor_Click" Background="Transparent" Padding="0"
                                                    Style="{StaticResource {x:Type Button}}">
                                                <Border CornerRadius="12" Background="{StaticResource ControlBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelColor, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11"/>
                                                        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="#555">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding OverlayColorHex, Converter={StaticResource HexToColorConverter}}"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.LabelOpacity, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox Style="{StaticResource NumTextBox}" Text="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="95" Value="{Binding Opacity}" TickFrequency="5" Margin="0,0,0,24"/>

                                        <StackPanel IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE745;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DataContext.Strings.LabelMargin, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBox Style="{StaticResource NumTextBox}" Text="{Binding Margin, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="px" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Slider Minimum="-50" Maximum="100" Value="{Binding Margin}" TickFrequency="1" Margin="0,0,0,24"/>
                                        </StackPanel>

                                        <!-- Dim Desktop Only (Moved UP) -->
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding DimDesktopOnly}" Content="{Binding DataContext.Strings.CheckDimDesktopOnly, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                       Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                       ToolTip="{Binding DataContext.Strings.TooltipDimDesktopOnly, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>

                                        <StackPanel Margin="20,0,0,0">
                                            <CheckBox IsChecked="{Binding ExcludeTaskbar}" Content="{Binding DataContext.Strings.CheckTaskbar, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                      IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}"/>
                                            <CheckBox IsChecked="{Binding ExcludeTopmost}" Content="{Binding DataContext.Strings.CheckTopmost, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}"/>
                                            <CheckBox IsChecked="{Binding UseTightFrame}" Content="{Binding DataContext.Strings.CheckTightFrame, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      IsEnabled="{Binding DimDesktopOnly, Converter={StaticResource InverseBooleanConverter}}"/>
                                        </StackPanel>

                                        <Separator Background="#30FFFFFF" Margin="0,12,0,12"/>


                                        <Border IsEnabled="{Binding DataContext.IsPro, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <!-- Pro Header for this section -->
                                                <Grid Margin="0,0,0,10" Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <TextBlock Text="🔒 PRO" HorizontalAlignment="Right" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="10"/>
                                                </Grid>
                                                
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding DimEntirelyWhenInactive}" Content="{Binding DataContext.Strings.CheckDimEntirely, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Strings.TooltipDimEntirely, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding DimWhenIdle}" Content="{Binding DataContext.Strings.CheckDimWhenIdle, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                               Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                               ToolTip="{Binding DataContext.Strings.TooltipDimWhenIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,5" Visibility="{Binding DimWhenIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Margin="28,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelIdleTime, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <!-- Grid inside StackPanel with Margin shifts width. But Auto col leans right. -->
                                                        <!-- To fix alignment with above items, we need to ensure the right edge matches. -->
                                                        <!-- Since Margin is on the Grid, it's indenting the whole grid. -->
                                                        <!-- The TextBoxes above end at Right=Width. This ends at Right=Width-28?? No, Margin reduces size but doesn't shift right edge to left? -->
                                                        <!-- Wait, Margin Left pushes content Right. So Right Edge is at ParentRight. -->
                                                        <!-- But if Parents width is restricted... -->
                                                        <!-- Actually the visual issue is likely simply due to different container widths or margins. -->
                                                        <!-- Let's match the margins of other items. -->
                                                        <!-- The other textboxes use 'NumTextBox' style which has margin '10,0,5,0'. -->
                                                        <!-- I will remove the Grid Margin '28' and use Padding on a container or margin on the left textblock instead to indent ONLY the label -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource NumTextBox}" Text="{Binding IdleTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="min" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="1" Maximum="120" Value="{Binding IdleTimeout}" TickFrequency="1" Margin="28,5,0,10"/>

                                                    <!-- New Idle Opacity Slider -->
                                                    <Grid Margin="28,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding DataContext.Strings.LabelOpacity, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>

                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource NumTextBox}" Text="{Binding IdleDimOpacity, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="95" Value="{Binding IdleDimOpacity}" TickFrequency="5" Margin="28,5,0,5"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding DataContext.IsPro, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DataContext.Strings.HeaderAnimation, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>
                                            <TextBlock Text="🔒 PRO" HorizontalAlignment="Right" Foreground="{StaticResource AccentColor}" FontWeight="Bold" 
                                                       Visibility="{Binding DataContext.FreeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding DataContext.Strings.LabelDarken, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelWait, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                                   Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                                   ToolTip="{Binding DataContext.Strings.TooltipWait, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DelayDarken, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="60" Value="{Binding DelayDarken}" TickFrequency="1" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelDuration, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DurationDarken, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="5" Value="{Binding DurationDarken}" TickFrequency="0.1"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="#30FFFFFF" Margin="0,15,0,15"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding DataContext.Strings.LabelBrighten, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DataContext.Strings.LabelDuration, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Style="{StaticResource NumTextBox}" Text="{Binding DurationBrighten, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="s" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Width="24" TextAlignment="Left" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="5" Value="{Binding DurationBrighten}" TickFrequency="0.1"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Right Global Settings (Column 1) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,0,0,0">
                <StackPanel Margin="0,0,0,20">
                    <!-- Global Settings Header -->
                    <StackPanel Margin="0,5,0,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Strings.HeaderGlobalSettings, FallbackValue='Global Settings'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <!-- Badge -->
                            <Border Background="#2260CDFF" BorderBrush="#8860CDFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Strings.BadgeAllMonitors, FallbackValue='ALL MONITORS'}" Foreground="#FF60CDFF" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Strings.SubHeaderGlobalSettings, FallbackValue='These settings apply to all connected monitors.'}" FontSize="11" Foreground="{StaticResource TextSecondary}" Opacity="0.8" Margin="28,0,0,0"/>
                    </StackPanel>

                    <!-- Card 1: Exclusion Lists (共通) -->
                                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsPro}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Strings.HeaderExclusionLists}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Debug Inspector Button -->
                                                <ToggleButton x:Name="DebugInspectorButton" Click="DebugInspector_Click" Cursor="Hand" 
                                                              ToolTip="{Binding Strings.TooltipDebugInspector}"
                                                              Margin="0,0,10,0">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                            <Setter Property="Padding" Value="8,3"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding Strings.BtnDebug}" FontSize="10" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="#44FFB900"/>
                                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFB900"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlBackgroundHover}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <TextBlock Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" VerticalAlignment="Center"
                                                           Visibility="{Binding FreeBannerVisibility}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Strings.LabelAppList}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding IgnoreList, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                            <Button Grid.Column="1" Content="..." Click="BrowseApp_Click" Margin="8,0,0,0" Width="36" Height="32"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Strings.LabelAlwaysBright}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AlwaysBrightList, UpdateSourceTrigger=PropertyChanged}" Height="32" BorderBrush="#228822" BorderThickness="0,0,0,2"/>
                                            <Button Grid.Column="1" Content="..." Click="BrowseBright_Click" Margin="8,0,0,0" Width="36" Height="32"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Strings.LabelAlwaysDark}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0" 
                                                       Foreground="{StaticResource TextTertiary}" Cursor="Help" VerticalAlignment="Center"
                                                       ToolTip="{Binding Strings.TooltipAlwaysDark}"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AlwaysDarkList, UpdateSourceTrigger=PropertyChanged}" Height="32" BorderBrush="#882222" BorderThickness="0,0,0,2"/>
                                            <Button Grid.Column="1" Content="..." Click="BrowseDark_Click" Margin="8,0,0,0" Width="36" Height="32"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>


                    <!-- Card 2: Hotkeys (共通) -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Strings.LabelToggle, FallbackValue='HOTKEYS'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </Grid>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Strings.LabelToggle}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                        <TextBox x:Name="HotkeyToggleBox" IsReadOnly="True" Width="110" Height="26" Background="#20FFFFFF"
                                 Text="Ctrl + Alt + Home" FontWeight="Bold" TextAlignment="Center" Tag="Toggle"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" Padding="2" FontSize="10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <TextBlock Text="{Binding Strings.LabelDarker}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                        <TextBox x:Name="HotkeyDarkerBox" IsReadOnly="True" Width="100" Height="26" Background="#20FFFFFF"
                                 Text="Ctrl + Alt + PgUp" TextAlignment="Center" Tag="Darker" FontSize="10"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="{Binding Strings.LabelLighter}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                        <TextBox x:Name="HotkeyLighterBox" IsReadOnly="True" Width="100" Height="26" Background="#20FFFFFF"
                                 Text="Ctrl + Alt + PgDn" TextAlignment="Center" Tag="Lighter" FontSize="10"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"/>
                    </StackPanel>
                </WrapPanel>

                        </StackPanel>
                    </Border>

                    <!-- Card 3: Presets (共通) -->
                    <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsPro}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Strings.HeaderPreset, FallbackValue='PRESETS'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🔒 PRO" Foreground="{StaticResource AccentColor}" FontWeight="Bold" VerticalAlignment="Center"
                                           Visibility="{Binding FreeBannerVisibility}"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="PresetComboBox" Style="{StaticResource RoundedComboBox}" 
                                          ItemsSource="{Binding GlobalPresets}" SelectedValue="{Binding SelectedGlobalPresetId}" 
                                          SelectedValuePath="Id" DisplayMemberPath="Name" SelectionChanged="GlobalPreset_SelectionChanged" Height="32"/>
                                <Button Grid.Column="1" Click="AddGlobalPreset_Click" Margin="8,0,0,0" Width="36" Height="32" ToolTip="{Binding Strings.TooltipAddPreset}">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="2" Click="EditGlobalPresetName_Click" Margin="8,0,0,0" Width="36" Height="32" ToolTip="{Binding Strings.TooltipEditPreset}">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="3" Click="DeleteGlobalPreset_Click" Margin="8,0,0,0" Width="36" Height="32" ToolTip="{Binding Strings.TooltipDeletePreset}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding Strings.LabelAssociatedProcesses}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding SelectedGlobalPreset.ProcessRules}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ControlBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="8,4" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <Button Command="{Binding DataContext.RemoveProcessRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Margin="6,0,0,0" Padding="0" Width="16" Height="16" Cursor="Hand">
                                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="{StaticResource TextSecondary}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Click="ManageProcessRules_Click" Width="26" Height="26" VerticalAlignment="Top" Background="Transparent" Cursor="Hand" ToolTip="{Binding Strings.BtnAddProcessRule}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13">
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Startup & Close (共通) -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Strings.HeaderStartup}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="{Binding Strings.CheckAutoStart}" Checked="AutoStart_Checked" Unchecked="AutoStart_Unchecked" Margin="0,0,20,0"/>
                        <CheckBox x:Name="AdminRunCheck" Content="{Binding Strings.CheckAdmin}" IsEnabled="{Binding ElementName=AutoStartCheck, Path=IsChecked}" Checked="AdminRun_Changed" Unchecked="AdminRun_Changed" Margin="0,0,20,0"/>
                    </WrapPanel>

                    <Button Grid.Column="1" Click="MinimizeButton_Click" Style="{StaticResource AccentButtonStyle}"
                            MinWidth="110" Height="32" FontSize="12"
                            VerticalAlignment="Center">
                         <StackPanel Orientation="Horizontal">
                             <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                             <TextBlock Text="{Binding Strings.BtnClose}" VerticalAlignment="Center"/>
                         </StackPanel>
                    </Button>
                </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</components:FluentWindow>
